runs/
checkpoints/
*.safetensors
*.gguf

# 训练数据与素材（本地资产，不得入库——Sine 3.4 起全部从零重建）
data_factory/
data_train/
*.jsonl

# 编辑器
.idea/
.vscode/

# 测试缓存
.pytest_cache/

# 自动化任务运行记忆（工具生成，非项目资产）
.workbuddy/

