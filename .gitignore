# macOS
.DS_Store
._*
__MACOSX/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 运行时数据（数据库、对话内容与情感状态不入库）
data/*.db
data/*.db-journal
data/emotion_state.json
logs/

# 数据工厂产物（数据集随项目入库，作为训练资产的一部分）
data_factory/heroine_samples.txt

# 训练产物（checkpoint 体积大且含数据，永不入库）
runs/
checkpoints/
*.safetensors
*.gguf

# 训练数据与素材（本地资产，不得入库——Sine 3.4 起全部从零重建）
# 例外：scene_defs.py 是场景定义代码，必须入库
data_factory/*
!data_factory/scene_defs.py
data_train/
*.jsonl

# 编辑器
.idea/
.vscode/

# 测试缓存
.pytest_cache/
# 测试临时目录（conftest.py 固定到项目内，避免受限环境里自动建目录被拦截）
.pytest_tmp/
# 端到端检查的临时数据库（e2e_check.py 建在项目内，同上原因）
.e2e_tmp/
# 训练/推理提示同构检查的临时目录（check_tokens.py 建在项目内，同上原因）
.parity_tmp/
# 视口核验的临时测量页（check_viewport.py 用完即删，异常退出时可能残留）
.vp_probe_*.html

# 自动化任务运行记忆（工具生成，非项目资产）
.workbuddy/

# 融合后的模型权重（839MB，可用 mlx_lm fuse 从 基座+adapter 复现）
models/

# EdgeOne 部署产物（CLI 自动生成的整包副本，含模型权重与数据库，2.3GB）
# 它是构建输出而非源代码，入包会造成源码双份与数据外泄
.edgeone/

# 本地环境变量（可能含密钥，永不入库）
.env

# 诊断脚本建的 checkpoint 符号链接目录（只是链接，不含权重，跑完可删）
.ckpt_probe/
.probe_tmp/
.e2e_tmp/
.pytest_tmp/

# 补台词的一次性脚本与其回滚快照（台词写完后即无用，不入库）
.beat_append/
